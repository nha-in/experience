{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "django",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "DATABASE_URL=postgres:///ohc_experience_demo",
        "REDIS_URL=redis://localhost:6379/0",
        "USE_DOCKER=no",
        "DJANGO_SETTINGS_MODULE=config.settings.local",
        "DJANGO_READ_DOT_ENV_FILE=true",
        ".venv/bin/honcho",
        "-f",
        ".claude/Procfile.dev",
        "start"
      ],
      "port": 8000
    }
  ]
}
