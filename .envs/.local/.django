# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython
# Redis
# ------------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# Celery
# ------------------------------------------------------------------------------

# Flower
CELERY_FLOWER_USER=debug
CELERY_FLOWER_PASSWORD=debug

# MinIO object storage
# ------------------------------------------------------------------------------
DJANGO_AWS_ACCESS_KEY_ID=ohc-local
DJANGO_AWS_SECRET_ACCESS_KEY=ohc-local-development-key
DJANGO_AWS_STORAGE_BUCKET_NAME=ohc-experience-media
DJANGO_AWS_S3_ENDPOINT_URL=http://minio:9000
DJANGO_AWS_S3_REGION_NAME=us-east-1
